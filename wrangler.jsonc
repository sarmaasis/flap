{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "flap",
	"main": "./worker/index.ts",
	"compatibility_date": "2026-09-02",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"not_found_handling": "single-page-application",
		"binding": "ASSETS",
		"run_worker_first": [
			"/api/*"
		]
	},
	"d1_databases": [
		// {
		// 	"binding": "DB",
		// 	"database_name": "flap",
		// 	"database_id": "REPLACE_WITH_D1_DATABASE_ID",
		// 	"migrations_dir": "migrations"
		// },
		{
			"binding": "DB",
			"database_name": "flap",
			// Keep this ID until you rename/create a D1 named `flap` (see README Cloudflare rename notes).
			"database_id": "845444de-8a4f-46d2-968e-b841b481f46f",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "ATTACHMENTS",
			"bucket_name": "flap-attachments"
		}
	],
	"send_email": [
		{
			"name": "SEB"
		}
	],
	"triggers": {
		"crons": ["* * * * *"]
	},
	"observability": {
		"enabled": true
	}
}
