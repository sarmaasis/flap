{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "flap",
	"main": "./worker/index.ts",
	"compatibility_date": "2026-09-02",
	"compatibility_flags": [
		"nodejs_compat"
	],
	// Place the Worker near back-ends (D1/R2/SES) based on observed latency.
	// Helps users far from the D1 primary (e.g. US vs India) without pinning a region.
	// Docs: https://developers.cloudflare.com/workers/configuration/placement/
	"placement": {
		"mode": "smart"
	},
	"assets": {
		"not_found_handling": "404-page",
		"binding": "ASSETS",
		"run_worker_first": [
			"/api/*",
			"/app",
			"/app/*",
			"/signup",
			"/login",
			"/setup",
			"/verify-email",
			"/forgot-password",
			"/reset-password",
			"/invite",
			"/invite/*",
			"/settings/referrals"
		]
	},
	// InboxHub: WebSocket hibernation fan-out (idle connections do not accrue DO duration).
	// Only v1 is applied / needed. A pending v2 deleted_classes + binding caused CF error 10061;
	// v2/v3 (delete then re-add) never applied in production — class from v1 still serves WS.
	"durable_objects": {
		"bindings": [
			{
				"name": "INBOX_HUB",
				"class_name": "InboxHub"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1-inbox-hub",
			"new_sqlite_classes": ["InboxHub"]
		}
	],
	"d1_databases": [
		// {
		// 	"binding": "DB",
		// 	"database_name": "flap",
		// 	"database_id": "REPLACE_WITH_D1_DATABASE_ID",
		// 	"migrations_dir": "migrations"
		// },
		{
			"binding": "DB",
			"database_name": "flap",
			// Keep this ID until you rename/create a D1 named `flap` (see README Cloudflare rename notes).
			"database_id": "845444de-8a4f-46d2-968e-b841b481f46f",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "ATTACHMENTS",
			"bucket_name": "flap-attachments"
		}
	],
	"send_email": [
		{
			"name": "SEB"
		}
	],
	"triggers": {
		"crons": ["* * * * *"]
	},
	"observability": {
		"enabled": true
	}
}
