{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "inlet",
	"main": "./worker/index.ts",
	"compatibility_date": "2026-09-02",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"not_found_handling": "single-page-application",
		"binding": "ASSETS",
		"run_worker_first": [
			"/api/*"
		]
	},
	"d1_databases": [
		// {
		// 	"binding": "DB",
		// 	"database_name": "inlet",
		// 	"database_id": "REPLACE_WITH_D1_DATABASE_ID",
		// 	"migrations_dir": "migrations"
		// },
		{
			"binding": "DB",
			"database_name": "inlet",
			"database_id": "4e9d434d-1893-4510-8d4b-b898939aaf48",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "INLET_ATTACHMENTS",
			"bucket_name": "inlet-attachments"
		}
	],
	"send_email": [
		{
			"name": "SEB"
		}
	],
	"observability": {
		"enabled": true
	}
}
