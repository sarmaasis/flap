{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "flap",
	"main": "./worker/index.ts",
	"compatibility_date": "2026-09-02",
	"compatibility_flags": [
		"nodejs_compat"
	],
	// Place the Worker near back-ends (D1/R2/SES) based on observed latency.
	// Helps users far from the D1 primary (e.g. US vs India) without pinning a region.
	// Docs: https://developers.cloudflare.com/workers/configuration/placement/
	"placement": {
		"mode": "smart"
	},
	"assets": {
		"not_found_handling": "404-page",
		"binding": "ASSETS",
		// Auth shells + marketing HTML: Worker serves prerender asset when present, else SPA
		// index (Vite dev has no prerender). Unknown paths still hit Assets 404-page.
		"run_worker_first": [
			"/api/*",
			// Exact /dav plus children. Do NOT add "/dav/" — Cloudflare rejects it as
			// redundant with "/dav/*" and @cloudflare/vite-plugin then fails to start.
			"/dav",
			"/dav/*",
			"/app",
			"/app/*",
			"/signup",
			"/login",
			"/setup",
			"/verify-email",
			"/sso-callback",
			"/auth/verify",
			"/forgot-password",
			"/reset-password",
			"/invite",
			"/invite/*",
			"/settings/referrals",
			"/about",
			"/pricing",
			"/support",
			"/status",
			"/terms",
			"/privacy",
			"/acceptable-use",
			"/abuse",
			"/how-we-send-email",
			"/billing-terms",
			"/tools",
			"/tools/*",
			"/docs",
			"/docs/*",
			"/guides",
			"/guides/*",
			"/blog",
			"/blog/*",
			"/google-workspace-alternative",
			"/email-for-multiple-domains",
			"/email-hosting-for-multiple-domains",
			"/custom-domain-email",
			"/email-for-indie-hackers",
			"/email-for-founders",
			"/email-for-side-projects",
			"/email-for-multiple-saas-products",
			"/email-for-venture-studios",
			"/how-to-manage-email-for-multiple-domains",
			"/how-to-send-email-from-multiple-domains",
			"/google-workspace-multiple-domains",
			"/flap-vs-google-workspace",
			"/flap-vs-zoho",
			"/multiple-domains-one-inbox",
			"/cloudflare-email-routing-alternative",
			"/hydra-alternative",
			"/folio-alternative",
			"/justemails-alternative",
			"/migadu-alternative",
			"/improvmx-alternative",
			// SEO aliases (301 via Worker)
			"/one-inbox-multiple-domains",
			"/one-inbox-for-multiple-businesses",
			"/email-for-agencies",
			"/email-for-portfolio-founders",
			"/custom-domain-email-for-side-projects",
			"/flap-vs-zoho-mail",
			"/flap-vs-folio",
			"/flap-vs-fastmail",
			"/security",
			"/migrate",
			"/why-not-amazon-ses",
			"/for",
			"/for/*",
			"/vs",
			"/vs/*",
			"/research",
			"/research/*",
			"/book",
			"/book/*",
			"/n",
			"/n/*"
		]
	},
	// InboxHub: WebSocket hibernation fan-out (idle connections do not accrue DO duration).
	// Only v1 is applied / needed. A pending v2 deleted_classes + binding caused CF error 10061;
	// v2/v3 (delete then re-add) never applied in production — class from v1 still serves WS.
	"durable_objects": {
		"bindings": [
			{
				"name": "INBOX_HUB",
				"class_name": "InboxHub"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1-inbox-hub",
			"new_sqlite_classes": ["InboxHub"]
		}
	],
	"d1_databases": [
		// {
		// 	"binding": "DB",
		// 	"database_name": "flap",
		// 	"database_id": "REPLACE_WITH_D1_DATABASE_ID",
		// 	"migrations_dir": "migrations"
		// },
		{
			"binding": "DB",
			"database_name": "flap",
			// Keep this ID until you rename/create a D1 named `flap` (see README Cloudflare rename notes).
			"database_id": "845444de-8a4f-46d2-968e-b841b481f46f",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "ATTACHMENTS",
			"bucket_name": "flap-attachments"
		}
	],
	"send_email": [
		{
			"name": "SEB"
		}
	],
	"triggers": {
		"crons": ["* * * * *"]
	},
	"observability": {
		"enabled": true
	}
}
