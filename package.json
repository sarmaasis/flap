{
  "name": "inlet",
  "version": "1.0.0",
  "private": true,
  "description": "Self-hosted custom-domain email inbox on your Cloudflare account.",
  "type": "module",
  "license": "MIT",
  "author": "Ashish Sharma",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && wrangler deploy",
    "types": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply inlet --local",
    "db:migrate:remote": "wrangler d1 migrations apply inlet --remote",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "hono": "^4.9.8",
    "postal-mime": "^2.4.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.13.0",
    "@cloudflare/workers-types": "latest",
    "@types/node": "^22.20.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.4",
    "wrangler": "4.34.0"
  }
}
