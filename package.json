{
  "name": "flap",
  "version": "1.0.0",
  "private": true,
  "description": "Flap — hosted custom-domain email at useflap.online.",
  "keywords": [
    "email",
    "inbox",
    "saas",
    "custom-domain",
    "cloudflare-workers",
    "flap"
  ],
  "type": "module",
  "license": "UNLICENSED",
  "author": "Ashish Sharma",
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run prerender",
    "prerender": "npx --yes tsx scripts/prerender.ts",
    "check": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.worker.json && npx --yes tsx shared/calculator.test.ts",
    "preview": "vite preview",
    "deploy": "npm run build && npm run db:migrate:remote && wrangler deploy",
    "types": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply inlet --local",
    "db:migrate:remote": "wrangler d1 migrations apply inlet --remote",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tiptap/extension-link": "^3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/extension-text-align": "^3.31.3",
    "@tiptap/extension-underline": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "better-auth": "^1.7.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dodopayments": "^2.49.0",
    "hono": "^4.9.8",
    "lucide-react": "^1.40.0",
    "postal-mime": "^2.4.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.3",
    "@cloudflare/workers-types": "latest",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.2",
    "vite": "^7.1.4",
    "wrangler": "^4.128.0"
  }
}
