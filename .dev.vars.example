# Clerk (https://dashboard.clerk.com → API Keys)
# Publishable key is public; secret stays on the Worker only.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Optional: PEM public key for networkless JWT verify on Workers
# (Dashboard → API Keys → Show JWT public key → PEM Public Key)
# CLERK_JWT_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Absolute public origin (scheme + host + port). Used for Dodo return URLs, authorized parties, links.
# Local: use 127.0.0.1 (or localhost) with the Vite port — never a bare path or host without http://
APP_URL=http://127.0.0.1:5173
# true = open signup; false = block new Flap users after the first account exists
SAAS_MODE=true

# From address for system / product mail (not Clerk auth mail — Clerk sends its own).
# Prefer SEB (Cloudflare Email Sending) for useflap.online when bound.
SYSTEM_FROM_EMAIL=noreply@useflap.online

# ─── Amazon SES (customer-domain send + receive; all plans) ─────────────────
# IAM user/role with SES + (optional) receipt-rule manage. Never expose to browsers.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Must support SES inbound receiving (e.g. us-east-1, us-west-2, eu-west-1)
AWS_SES_REGION=us-east-1
# Optional: configuration set name wired to bounce/complaint → /api/inbound/ses/events
# SES_CONFIGURATION_SET=flap-outbound
# Receipt rule set + S3 bucket from infra/ses-inbound CloudFormation
# SES_RECEIPT_RULE_SET=flap-inbound
# SES_INBOUND_BUCKET=flap-ses-inbound-…
# Shared HMAC secret between Lambda and Worker
SES_INBOUND_WEBHOOK_SECRET=
# Local only: allow unsigned SES inbound POSTs when secret unset
# SES_INBOUND_ALLOW_UNSIGNED=true
# Inbound webhook (production): https://useflap.online/api/inbound/ses

# ─── Mailgun (legacy customer domains during migration only) ────────────────
# Dashboard → API Security → API keys (Private API key)
MAILGUN_API_KEY=
# Sending → Webhooks → HTTP webhook signing key (preferred for inbound verify)
MAILGUN_WEBHOOK_SIGNING_KEY=
# Optional EU: https://api.eu.mailgun.net
# MAILGUN_API_BASE=https://api.mailgun.net
# Local only: allow unsigned inbound POSTs when signing key unset
# MAILGUN_WEBHOOK_ALLOW_UNSIGNED=true
# Legacy inbound: https://useflap.online/api/inbound/mailgun

# ─── Dodo Payments (https://docs.dodopayments.com) ───────────────────────────
# Test and live are SEPARATE: keys, webhooks, and products do not cross over.
# Dashboard → toggle Test/Live → Developer → API keys / Webhooks / Products
#
# LOCAL TEST CHECKOUT (required for Upgrade buttons to work):
#   1. Dashboard in Test Mode
#   2. Create Solo / Pro / Team / Scale subscription products → copy pdt_… ids
#   3. Create a test API key (often prefixed dodo_test_…)
#   4. Keep ENVIRONMENT=test_mode  (hits https://test.dodopayments.com)
#   5. Restart `npm run dev` after editing this file
#
# Leave API key / product IDs blank for demos: Billing shows “not configured”
# instead of broken checkout. test_mode alone does NOT disable checkout.
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
# test_mode | live_mode
DODO_PAYMENTS_ENVIRONMENT=test_mode
# Product IDs from the SAME mode as the API key (subscription products)
DODO_PRODUCT_SOLO=
DODO_PRODUCT_PRO=
DODO_PRODUCT_TEAM=
DODO_PRODUCT_SCALE=
# Legacy aliases (still accepted):
# DODO_PRODUCT_STARTER → Solo, DODO_PRODUCT_BUILDER → Pro
# DODO_PRODUCT_STUDIO / DODO_PRODUCT_BUSINESS → Team
DODO_PRODUCT_STARTER=
DODO_PRODUCT_BUILDER=
DODO_PRODUCT_STUDIO=
DODO_PRODUCT_BUSINESS=

# Annual Dodo products (10× monthly)
# DODO_PRODUCT_SOLO_ANNUAL=
# DODO_PRODUCT_PRO_ANNUAL=
# DODO_PRODUCT_TEAM_ANNUAL=
# DODO_PRODUCT_SCALE_ANNUAL=

# Production secrets (wrangler secret put …):
# CLERK_PUBLISHABLE_KEY, CLERK_SECRET_KEY, CLERK_JWT_KEY (optional)
# APP_URL=https://useflap.online
# SYSTEM_FROM_EMAIL=noreply@useflap.online
# AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_SES_REGION
# SES_INBOUND_WEBHOOK_SECRET, SES_RECEIPT_RULE_SET, SES_INBOUND_BUCKET
# MAILGUN_API_KEY, MAILGUN_WEBHOOK_SIGNING_KEY (legacy only)
# DODO_PAYMENTS_API_KEY, DODO_PAYMENTS_WEBHOOK_KEY, DODO_PAYMENTS_ENVIRONMENT=live_mode
# DODO_PRODUCT_SOLO, DODO_PRODUCT_PRO, DODO_PRODUCT_TEAM, DODO_PRODUCT_SCALE
# Webhook URL: https://useflap.online/api/billing/webhook
# SES inbound: https://useflap.online/api/inbound/ses
# Clerk: enable Email link + Google/GitHub in Dashboard; allowed origins include APP_URL
#         and redirect URLs /sso-callback, /auth/verify
