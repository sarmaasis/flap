SESSION_SECRET=change-me-to-a-long-random-string
# Absolute public origin (scheme + host + port). Required for Dodo return_url + OAuth callbacks.
# Local test: use 127.0.0.1 (or localhost) with the Vite port — never a bare path or host without http://
APP_URL=http://127.0.0.1:5173
# true = open signup; false = first-boot setup only after users exist
SAAS_MODE=true

# Google OAuth (Cloudflare Workers — authorized redirect URI must match APP_URL)
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client (Web)
# Authorized redirect URI: http://127.0.0.1:5173/api/auth/google/callback
# Production: https://useflap.online/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional GitHub OAuth
# GitHub → Settings → Developer settings → OAuth Apps
# Authorization callback URL: http://127.0.0.1:5173/api/auth/github/callback
# Production: https://useflap.online/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─── Dodo Payments (https://docs.dodopayments.com) ───────────────────────────
# Test and live are SEPARATE: keys, webhooks, and products do not cross over.
# Dashboard → toggle Test/Live → Developer → API keys / Webhooks / Products
#
# LOCAL TEST CHECKOUT (required for Upgrade buttons to work):
#   1. Dashboard in Test Mode
#   2. Create subscription products → copy pdt_… ids below
#   3. Create a test API key (often prefixed dodo_test_…)
#   4. Keep ENVIRONMENT=test_mode  (hits https://test.dodopayments.com)
#   5. Restart `npm run dev` after editing this file
#
# Leave API key / product IDs blank for demos: Billing shows “not configured”
# instead of broken checkout. test_mode alone does NOT disable checkout.
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
# test_mode | live_mode
# - test_mode → https://test.dodopayments.com  (use test keys + test product ids)
# - live_mode → https://live.dodopayments.com  (use live keys + live product ids)
# Mixing a test key with live_mode (or vice versa) returns Unauthorized.
DODO_PAYMENTS_ENVIRONMENT=test_mode
# Product IDs from the SAME mode as the API key (subscription products)
DODO_PRODUCT_PRO=
DODO_PRODUCT_TEAM=
# Legacy aliases (still accepted): DODO_PRODUCT_STARTER → Pro, DODO_PRODUCT_BUSINESS → Team
DODO_PRODUCT_STARTER=
DODO_PRODUCT_BUSINESS=

# Production secrets (wrangler secret put …):
# SESSION_SECRET, APP_URL=https://useflap.online
# GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET
# GITHUB_CLIENT_ID, GITHUB_CLIENT_SECRET (optional)
# DODO_PAYMENTS_API_KEY, DODO_PAYMENTS_WEBHOOK_KEY, DODO_PAYMENTS_ENVIRONMENT=live_mode
# DODO_PRODUCT_PRO, DODO_PRODUCT_TEAM
# Webhook URL: https://useflap.online/api/billing/webhook
# OAuth callbacks: https://useflap.online/api/auth/google/callback
#                  https://useflap.online/api/auth/github/callback
